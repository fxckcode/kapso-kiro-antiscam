# --- Comunes ---
AWS_REGION=us-east-1

# --- LambdaWebhook ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/antiscambot-analysis
# Secreto para validar la firma del webhook (en prod: Secrets Manager/SSM)
KAPSO_WEBHOOK_SECRET=2bd35e5aea3754195f31e2df023f350917771801bfde82d7f18533e931703e5e
# Header donde llega la firma HMAC del cuerpo (Kapso usa: x-webhook-signature)
KAPSO_SIGNATURE_HEADER=x-webhook-signature
# Opcional: header de token compartido como esquema alternativo de auth
# KAPSO_TOKEN_HEADER=x-kapso-token
# Secreto HMAC para seudonimizar el telefono (en prod: Secrets Manager/SSM)
USER_ID_HMAC_SECRET=replace-me
MESSAGE_MAX_LENGTH=4096
DEFAULT_LOCALE=es

# --- Envio por Kapso (webhook onboarding + processor) ---
# Endpoint Meta-compatible de Kapso para enviar mensajes.
KAPSO_API_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
KAPSO_API_KEY=80be3208732df43320f420ee2eb418b7d376b818b7b202b0e30c0139b0e19cb7
# ID del numero de WhatsApp en Kapso (requerido por el endpoint de envio).
KAPSO_PHONE_NUMBER_ID=1271974085991087

# --- Consentimiento (DynamoDB) ---
# Si CONSENT_TABLE_NAME esta vacio, se usa el fallback en memoria (solo dev/local).
CONSENT_TABLE_NAME=
CONSENT_TTL_DAYS=30

# --- QR de Kapso (setup) ---
KAPSO_QR_PATH=/qr
# KAPSO_QR_MOCK=true   # devuelve un QR simulado sin llamar a la red

# --- Routing token (opcional, DESACTIVADO por defecto) ---
ENABLE_ROUTING_TOKEN=false
# ROUTING_TOKEN_KMS_KEY_ID=arn:aws:kms:...:key/...

# --- Logging ---
LOG_LEVEL=info
